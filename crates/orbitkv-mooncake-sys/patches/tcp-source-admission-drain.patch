+int TransferEngineImpl::closeSource(uint64_t timeout_ms, char* epoch, uint64_t* active) {
+    if (!metadata_ || !epoch || !active || timeout_ms > 5000) return -1;
+    memcpy(epoch, metadata_->sourceEpoch().c_str(), 33);
+    *active = metadata_->closeSource(timeout_ms);
+#ifdef USE_CUDA
+    // CPU handler return does not establish device completion on a CUDA build.
+    return 2;
+#else
+    if (Platform::getLoader().type() != "cpu") return 2;
+    for (size_t type = 0; type < kSupportedTransportTypes; ++type)
+        if (type != TCP && transport_list_[type]) return 2;
+    return *active == 0 ? 0 : 1;
+#endif
+}
